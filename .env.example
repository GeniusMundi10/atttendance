# Database connection for the ELT server and migration operator only.
DATABASE_URL=
# Supabase auth project with asymmetric JWT signing enabled; public browser settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Play Integrity and biometric template credentials.
KIOSK_PLAY_SERVICE_ACCOUNT_JSON=
KIOSK_PLAY_CERT_SHA256=
KIOSK_TEMPLATE_KEY_HEX=
# Enrollment code digest key and approved notice configuration (server only).
KIOSK_ENROLLMENT_CODE_KEY_HEX=
KIOSK_FACE_ENROLLMENT_NOTICE_VERSION=
KIOSK_FACE_ENROLLMENT_NOTICE_TEXT=
# Server-only random bearer secret shared with Supabase Cron via Vault.
WHATSAPP_CRON_SECRET=
# WhatsApp Cloud API punch alerts. The template takes {{1}} first name, {{2}} checked in/out, {{3}} IST time.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Android upload signing examples for Gradle/CI only; these are dummy values.
# Gradle reads process environment variables and does not load this file itself.
ELT_UPLOAD_KEYSTORE_FILE=C:/path/to/elt-upload.jks
ELT_UPLOAD_KEYSTORE_PASSWORD=REPLACE_WITH_LOCAL_SECRET
ELT_UPLOAD_KEY_ALIAS=elt-upload
ELT_UPLOAD_KEY_PASSWORD=REPLACE_WITH_LOCAL_SECRET
